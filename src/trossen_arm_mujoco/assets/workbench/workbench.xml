<mujoco model="workbench">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <site group="4"/>
    <default class="visual">
      <geom type="mesh" group="2" contype="0" conaffinity="0"/>
    </default>
    <!-- TODO(abhismirai42): collision uses the same simplified meshes (convex-hulled by the engine) as a placeholder;
         replace with hand-tuned primitives-->
    <default class="collision">
      <geom type="mesh" group="3" mass="0" density="0"/>
    </default>
  </default>

  <asset>
    <model name="wxpro" file="../wxpro/wxpro.xml"/>

    <material name="color_0" rgba="0.2627 0.2824 0.302 1"/>
    <material name="color_2" rgba="0.8667 0.3216 0.1569 1"/>
    <material name="color_4" rgba="0.702 0.702 0.702 1"/>
    <material name="color_7" rgba="0.08627 0.3216 0.5804 1"/>
    <material name="color_9" rgba="1.0 0.0 0.0 1"/>
    <material name="zed_camera" rgba="0.25 0.25 0.25 1"/>

    <mesh name="workbench_base_collision_plate" file="workbench/workbench_base_collision_plate.obj"/>
    <mesh name="workbench_base_collision_housing" file="workbench/workbench_base_collision_housing.obj"/>
    <mesh name="workbench_base_collision_mast" file="workbench/workbench_base_collision_mast.obj"/>
    <mesh name="workbench_base_collision_handle_left" file="workbench/workbench_base_collision_handle_left.obj"/>
    <mesh name="workbench_base_collision_handle_right" file="workbench/workbench_base_collision_handle_right.obj"/>
    <mesh name="workbench_base_color_0" file="workbench/workbench_base_color_0.obj"/>
    <mesh name="workbench_base_color_2" file="workbench/workbench_base_color_2.obj"/>
    <mesh name="workbench_base_color_4" file="workbench/workbench_base_color_4.obj"/>
    <mesh name="workbench_base_color_7" file="workbench/workbench_base_color_7.obj"/>
    <mesh name="workbench_base_color_9" file="workbench/workbench_base_color_9.obj"/>

    <mesh name="zedxm" file="peripherals/zedxm.stl"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0">
      <geom class="visual" mesh="workbench_base_color_0" material="color_0"/>
      <geom class="visual" mesh="workbench_base_color_2" material="color_2"/>
      <geom class="visual" mesh="workbench_base_color_4" material="color_4"/>
      <geom class="visual" mesh="workbench_base_color_7" material="color_7"/>
      <geom class="visual" mesh="workbench_base_color_9" material="color_9"/>
      <geom class="collision" mesh="workbench_base_collision_plate"/>
      <geom class="collision" mesh="workbench_base_collision_housing"/>
      <geom class="collision" mesh="workbench_base_collision_mast"/>
      <geom class="collision" mesh="workbench_base_collision_handle_left"/>
      <geom class="collision" mesh="workbench_base_collision_handle_right"/>
      <!-- TODO(abhismirai42): update inertial property for base_link -->
      <inertial pos="0 0 0" mass="10" fullinertia="0.1 0.1 0.1 0 0 0"/>

      <body name="cam_high_camera_link" pos="0.028173 0 0.857613" quat="0.9063077 0 0.4226184 0">
        <body name="cam_high_camera_center" pos="0 0 0.016">
          <geom class="visual" mesh="zedxm" material="zed_camera" pos="0 0 -0.016"/>
          <geom class="collision" mesh="zedxm" pos="0 0 -0.016"/>
          <inertial pos="0 0 0" mass="0.15" diaginertia="0.00012325 2.99125e-05 0.0001275625"/>
          <site name="cam_high_left_camera_frame" pos="-0.01 0.025 0" size="0.002"/>
          <site name="cam_high_right_camera_frame" pos="-0.01 -0.025 0" size="0.002"/>
        </body>
      </body>

      <!-- right arm -->
      <frame pos="0 -0.274 0.0064">
        <attach model="wxpro" body="base_link" prefix="follower_right_"/>
      </frame>

      <!-- left arm -->
      <frame pos="0 0.274 0.0064">
        <attach model="wxpro" body="base_link" prefix="follower_left_"/>
      </frame>
    </body>
  </worldbody>

  <!-- TODO(abhismirai42): update mesh collision -->
  <contact>
    <exclude body1="base_link" body2="follower_right_link_1"/>
    <exclude body1="base_link" body2="follower_right_link_2"/>
    <exclude body1="base_link" body2="follower_left_link_1"/>
    <exclude body1="base_link" body2="follower_left_link_2"/>
  </contact>

</mujoco>
