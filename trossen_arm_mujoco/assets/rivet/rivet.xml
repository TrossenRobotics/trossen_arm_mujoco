<mujoco model="rivet">
  <compiler angle="radian" meshdir="../meshes" texturedir="../" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="visual">
      <geom type="mesh" group="2" contype="0" conaffinity="0"/>
    </default>
    <!-- TODO(abhismirai42): collision uses the same simplified meshes (convex-hulled by the engine) as a placeholder;
         replace with hand-tuned primitives-->
    <default class="collision">
      <geom type="mesh" group="3" mass="0" density="0"/>
    </default>
  </default>

  <asset>
    <model name="wxpro" file="../wxpro/wxpro.xml"/>

    <material name="zed_camera" rgba="0.25 0.25 0.25 1"/>
    <!-- rivet base parts -->
    <material name="color_8" rgba="0.302 0.302 0.302 1"/>

    <mesh name="rivet_base_link" file="rivet/base_link.obj" />
    <mesh name="lift_link" file="rivet/lift_link.obj" />
    <mesh name="pivot_link" file="rivet/pivot_link.obj" />
    <mesh name="wheel" file="rivet/wheel.obj" />

    <mesh name="zedxm" file="peripherals/zedxm.stl"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0.1285">
      <freejoint name="base_freejoint"/>
      <geom class="visual" mesh="rivet_base_link" material="color_8"/>
      <geom class="collision" mesh="rivet_base_link"/>
      <inertial pos="-0.0332838 0.00387668 0.198466" mass="73.7606"
        fullinertia="5.76624 6.32878 2.94862 0.0 -0.51839 0.00555349"/>

      <body name="lift_link" pos="0.165 0.0 0.181">
        <joint name="lift" type="slide" pos="0 0 0" axis="0 0 1" range="0.0 0.858"/>
        <geom class="visual" mesh="lift_link" material="color_8"/>
        <geom class="collision" mesh="lift_link"/>
        <inertial pos="0.0543177 0 0.0192157" mass="2.69782"
          fullinertia="0.102184 0.0103103 0.0952441 0.0 -0.000235492 0.0"/>

        <body name="cam_high_camera_link" pos="0.0906 0 0.3267" quat="0.9762960 0 0.2164395 0">
          <body name="cam_high_camera_center" pos="0 0 0.016">
            <geom class="visual" mesh="zedxm" material="zed_camera" pos="0 0 -0.016"/>
            <geom class="collision" mesh="zedxm" pos="0 0 -0.016"/>
            <inertial pos="0 0 0" mass="0.15" diaginertia="0.00012325 2.99125e-05 0.0001275625"/>
            <site name="cam_high_left_camera_frame" pos="-0.01 0.025 0" size="0.002"/>
            <site name="cam_high_right_camera_frame" pos="-0.01 -0.025 0" size="0.002"/>
          </body>
        </body>

        <!-- follower_right arm -->
        <frame pos="0.0615 -0.275 0.031">
          <attach model="wxpro" body="base_link" prefix="follower_right_"/>
        </frame>

        <!-- follower_left arm -->
        <frame pos="0.0615 0.275 0.031">
          <attach model="wxpro" body="base_link" prefix="follower_left_"/>
        </frame>
      </body>

      <body name="b_pivot_link" pos="-0.24 0.0 0.003">
        <joint name="b_pivot" pos="0 0 0" axis="0 0 1"/>
        <geom class="visual" mesh="pivot_link" material="color_8"/>
        <geom class="collision" mesh="pivot_link"/>
        <inertial pos="0 0 -0.0395608" mass="0.619024" fullinertia="0.00137238 0.000923685 0.00117765 0.0 0.0 0.0"/>
        <body name="b_drive_link" pos="0 0 -0.078">
          <joint name="b_drive" pos="0 0 0" axis="0 1 0"/>
          <geom class="visual" mesh="wheel" material="color_8"/>
          <geom class="collision" type="cylinder" size="0.0535 0.0205" pos="0 0 0" quat="1 1 0 0"/>
          <inertial pos="0 0 0" mass="0.330766" fullinertia="0.000294662 0.000500429 0.000294662 0.0 0.0 0.0"/>
        </body>
      </body>

      <body name="fr_pivot_link" pos="0.24 -0.190 0.003">
        <joint name="fr_pivot" pos="0 0 0" axis="0 0 1"/>
        <geom class="visual" mesh="pivot_link" material="color_8"/>
        <geom class="collision" mesh="pivot_link"/>
        <inertial pos="0 0 -0.0395608" mass="0.619024" fullinertia="0.00137238 0.000923685 0.00117765 0.0 0.0 0.0"/>
        <body name="fr_drive_link" pos="0 0 -0.078">
          <joint name="fr_drive" pos="0 0 0" axis="0 1 0"/>
          <geom class="visual" mesh="wheel" material="color_8"/>
          <geom class="collision" type="cylinder" size="0.0535 0.0205" pos="0 0 0" quat="1 1 0 0"/>
          <inertial pos="0 0 0" mass="0.330766" fullinertia="0.000294662 0.000500429 0.000294662 0.0 0.0 0.0"/>
        </body>
      </body>

      <body name="fl_pivot_link" pos="0.24 0.190 0.003">
        <joint name="fl_pivot" pos="0 0 0" axis="0 0 1"/>
        <geom class="visual" mesh="pivot_link" material="color_8"/>
        <geom class="collision" mesh="pivot_link"/>
        <inertial pos="0 0 -0.0395608" mass="0.619024" fullinertia="0.00137238 0.000923685 0.00117765 0.0 0.0 0.0"/>
        <body name="fl_drive_link" pos="0 0 -0.078">
          <joint name="fl_drive" pos="0 0 0" axis="0 1 0"/>
          <geom class="visual" mesh="wheel" material="color_8"/>
          <geom class="collision" type="cylinder" size="0.0535 0.0205" pos="0 0 0" quat="1 1 0 0"/>
          <inertial pos="0 0 0" mass="0.330766" fullinertia="0.000294662 0.000500429 0.000294662 0.0 0.0 0.0"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- TODO(abhismirai42): update mesh collision -->
  <contact>
    <exclude body1="base_link" body2="b_pivot_link"/>
    <exclude body1="base_link" body2="fr_pivot_link"/>
    <exclude body1="base_link" body2="fl_pivot_link"/>
    <exclude body1="b_pivot_link" body2="b_drive_link"/>
    <exclude body1="fr_pivot_link" body2="fr_drive_link"/>
    <exclude body1="fl_pivot_link" body2="fl_drive_link"/>
    <exclude body1="base_link" body2="b_drive_link"/>
    <exclude body1="base_link" body2="fr_drive_link"/>
    <exclude body1="base_link" body2="fl_drive_link"/>

    <exclude body1="lift_link" body2="follower_right_link_1"/>
    <exclude body1="lift_link" body2="follower_left_link_1"/>
    <exclude body1="lift_link" body2="follower_right_link_2"/>
    <exclude body1="lift_link" body2="follower_left_link_2"/>
  </contact>

  <actuator>
    <!-- TODO(abhismirai42): placeholder gains/limits; no real lift-actuator or drive-motor specs available yet -->
    <position name="lift" joint="lift" kp="2000" kv="200" ctrlrange="0.0 0.858" forcerange="-500 500"/>
    <position name="b_pivot" joint="b_pivot" kp="50" kv="5" ctrlrange="-3.14159265 3.14159265" forcerange="-10 10"/>
    <position name="fr_pivot" joint="fr_pivot" kp="50" kv="5" ctrlrange="-3.14159265 3.14159265" forcerange="-10 10"/>
    <position name="fl_pivot" joint="fl_pivot" kp="50" kv="5" ctrlrange="-3.14159265 3.14159265" forcerange="-10 10"/>
    <velocity name="b_drive" joint="b_drive" kv="1000" ctrlrange="-18.691589 18.691589" forcerange="-4 4"/>
    <velocity name="fr_drive" joint="fr_drive" kv="1000" ctrlrange="-18.691589 18.691589" forcerange="-4 4"/>
    <velocity name="fl_drive" joint="fl_drive" kv="1000" ctrlrange="-18.691589 18.691589" forcerange="-4 4"/>
  </actuator>

</mujoco>
