<mujoco model="wxai base follow target scene">
  <option integrator="implicitfast"/>

  <statistic center="0 0 0.1" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <model name="wxai_follower" file="wxai_follower.xml"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <attach model="wxai_follower" body="base_link" prefix=""/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Target cube: mocap body (no joints or dynamics). Its pose is set through data.mocap_pos/mocap_quat
         and can be dragged in the viewer. https://mujoco.readthedocs.io/en/stable/modeling.html#mocap-bodies -->
    <body name="target_cube" pos="0.3 0.0 0.2" mocap="true">
      <geom name="target_cube_visual" type="box" size="0.02575 0.02575 0.02575" rgba="0 0 1 0.7" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0" size="0.0001" rgba="1 0 0 1"/>
    </body>
  </worldbody>
</mujoco>
