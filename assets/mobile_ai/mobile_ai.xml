<mujoco model="mobile_ai">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>

  <option integrator="implicitfast" noslip_iterations="1"/>

  <default>
    <site group="4"/>
    <default class="visual">
      <geom type="mesh" group="2" contype="0" conaffinity="0" material="trossen_black"/>
    </default>
    <default class="collision">
      <geom type="cylinder" group="3" mass="0" density="0"/>
    </default>
  </default>

  <asset>
    <material name="trossen_black" rgba="0.1 0.1 0.1 1"/>
    <material name="color_0" rgba="0.098 0.098 0.098 1"/>
    <material name="color_1" rgba="0.9647 0.9647 0.9529 1"/>
    <material name="color_2" rgba="0.6275 0.6275 0.6275 1"/>
    <material name="aluminum" rgba="0.5 0.5 0.5 1"/>

    <mesh name="base_link_color_0" file="mobile_ai/base_link_color_0.obj"/>
    <mesh name="base_link_color_1" file="mobile_ai/base_link_color_1.obj"/>
    <mesh name="base_link_color_2" file="mobile_ai/base_link_color_2.obj"/>
    <mesh name="wheel" file="mobile_ai/wheel.stl"/>
    <mesh name="caster_swivel" file="mobile_ai/caster_swivel.stl"/>
    <mesh name="caster_wheel" file="mobile_ai/caster_wheel.stl"/>
    <mesh name="d405" file="peripherals/d405.stl" scale="0.001 0.001 0.001"/>

    <model name="wxai_follower" file="../wxai/wxai_follower.xml"/>
  </asset>

  <worldbody>
    <body name="mobile_base_link" pos="0 0 0">
      <inertial pos="0.015755857 0.001604396 0.43669078" quat="0.0003187242 0.69123976 -0.0025557311 -0.7226209" mass="80.072" diaginertia="0.56298077 0.68247679 0.84921901"/>
      <freejoint name="mobile_base_freejoint"/>
      <geom class="visual" pos="0 0 0.211" quat="0.707107 -0.707107 0 0" mesh="base_link_color_0" material="color_0"/>
      <geom class="visual" pos="0 0 0.211" quat="0.707107 -0.707107 0 0" mesh="base_link_color_1" material="color_1"/>
      <geom class="visual" pos="0 0 0.211" quat="0.707107 -0.707107 0 0" mesh="base_link_color_2" material="color_2"/>
      <geom class="collision" type="box" size="0.19 0.27 0.3" pos="0 0 0.511"/>
      <geom class="collision" type="box" size="0.28 0.28 0.09" pos="0 0 0.121"/>
      <geom class="collision" type="box" size="0.035 0.04 0.115" pos="0.155 -0.23 0.926"/>
      <geom class="collision" type="box" size="0.035 0.04 0.115" pos="0.155 0.23 0.926"/>
      <geom class="collision" type="box" size="0.025 0.27 0.02" pos="0.215 0 1.022"/>
      <geom class="collision" type="box" size="0.065 0.1225 0.02" pos="0.3017 -0.265 1.022"/>
      <geom class="collision" type="box" size="0.065 0.1225 0.02" pos="0.3017 0.265 1.022"/>
      <geom class="collision" type="box" size="0.0025 0.0275 0.1125" pos="0.1875 0 1.151"/>

      <geom class="visual" pos="0.234143 0 1.25073" quat="0.315509 0.632814 0.632814 0.315509" mesh="d405" material="aluminum"/>
      <geom class="collision" type="box" size="0.0365 0.025 0.025" pos="0.204879 0 1.27271" quat="0.948324 0 0.317305 0"/>
      <site name="cam_high_color_frame" pos="0.231879 0.009 1.25071" quat="0.948324 0 0.317305 0" size="0.005"/>
      <camera name="cam_high" pos="0.231879 0.009 1.25071" quat="0.6329 0.3155 -0.3155 -0.6329" mode="fixed" fovy="120"/>

      <body name="left_wheel_link" pos="0 0.192 0.0851">
        <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="3" diaginertia="0.00291162 0.00165793 0.00165793"/>
        <joint name="left_wheel" pos="0 0 0" axis="0 1 0" actuatorfrcrange="-4 4" frictionloss="0.1" armature="0.005"/>
        <geom class="visual" mesh="wheel"/>
        <geom name="left_wheel_collision" class="collision" type="sphere" size="0.085"/>
      </body>
      <body name="right_wheel_link" pos="0 -0.192 0.0851">
        <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="3" diaginertia="0.00291162 0.00165793 0.00165793"/>
        <joint name="right_wheel" pos="0 0 0" axis="0 1 0" actuatorfrcrange="-4 4" frictionloss="0.1" armature="0.005"/>
        <geom class="visual" mesh="wheel"/>
        <geom name="right_wheel_collision" class="collision" type="sphere" size="0.085"/>
      </body>
      <body name="caster_swivel_front_left" pos="0.168 0.17 0.104">
        <inertial pos="-0.00642926 0 -0.0232438" quat="0.959318 0 -0.282329 0" mass="0.1" diaginertia="3.80031e-05 3.55224e-05 2.07153e-05"/>
        <joint name="caster_swivel_joint_front_left" pos="0 0 0" axis="0 0 1"/>
        <geom class="visual" mesh="caster_swivel"/>
        <body name="caster_wheel_front_left" pos="-0.0345 0 -0.066">
          <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.535" diaginertia="6.42431e-05 3.50668e-05 3.50668e-05"/>
          <joint name="caster_wheel_joint_front_left" pos="0 0 0" axis="0 1 0"/>
          <geom class="visual" mesh="caster_wheel"/>
          <geom class="collision" type="sphere" size="0.038"/>
        </body>
      </body>
      <body name="caster_swivel_front_right" pos="0.16843 -0.17 0.104">
        <inertial pos="-0.00642926 0 -0.0232438" quat="0.959318 0 -0.282329 0" mass="0.1" diaginertia="3.80031e-05 3.55224e-05 2.07153e-05"/>
        <joint name="caster_swivel_joint_front_right" pos="0 0 0" axis="0 0 1"/>
        <geom class="visual" mesh="caster_swivel"/>
        <body name="caster_wheel_front_right" pos="-0.0345 0 -0.066">
          <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.535" diaginertia="6.42431e-05 3.50668e-05 3.50668e-05"/>
          <joint name="caster_wheel_joint_front_right" pos="0 0 0" axis="0 1 0"/>
          <geom class="visual" mesh="caster_wheel"/>
          <geom class="collision" type="sphere" size="0.038"/>
        </body>
      </body>
      <body name="caster_swivel_rear_left" pos="-0.16783 0.17 0.104">
        <inertial pos="-0.00642926 0 -0.0232438" quat="0.959318 0 -0.282329 0" mass="0.1" diaginertia="3.80031e-05 3.55224e-05 2.07153e-05"/>
        <joint name="caster_swivel_joint_rear_left" pos="0 0 0" axis="0 0 1"/>
        <geom class="visual" mesh="caster_swivel"/>
        <body name="caster_wheel_rear_left" pos="-0.0345 0 -0.066">
          <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.535" diaginertia="6.42431e-05 3.50668e-05 3.50668e-05"/>
          <joint name="caster_wheel_joint_rear_left" pos="0 0 0" axis="0 1 0"/>
          <geom class="visual" mesh="caster_wheel"/>
          <geom class="collision" type="sphere" size="0.038"/>
        </body>
      </body>
      <body name="caster_swivel_rear_right" pos="-0.168 -0.17 0.104">
        <inertial pos="-0.00642926 0 -0.0232438" quat="0.959318 0 -0.282329 0" mass="0.1" diaginertia="3.80031e-05 3.55224e-05 2.07153e-05"/>
        <joint name="caster_swivel_joint_rear_right" pos="0 0 0" axis="0 0 1"/>
        <geom class="visual" mesh="caster_swivel"/>
        <body name="caster_wheel_rear_right" pos="-0.0345 0 -0.066">
          <inertial pos="0 0 0" quat="0.707107 0 0 0.707107" mass="0.535" diaginertia="6.42431e-05 3.50668e-05 3.50668e-05"/>
          <joint name="caster_wheel_joint_rear_right" pos="0 0 0" axis="0 1 0"/>
          <geom class="visual" mesh="caster_wheel"/>
          <geom class="collision" type="sphere" size="0.038"/>
        </body>
      </body>
      <frame pos="0.331 0.3 1.042">
        <attach model="wxai_follower" body="base_link" prefix="follower_left_"/>
      </frame>
      <frame pos="0.331 -0.3 1.042">
        <attach model="wxai_follower" body="base_link" prefix="follower_right_"/>
      </frame>
    </body>
  </worldbody>

  <contact>
    <exclude body1="mobile_base_link" body2="left_wheel_link"/>
    <exclude body1="mobile_base_link" body2="right_wheel_link"/>
    <exclude body1="mobile_base_link" body2="caster_swivel_front_left"/>
    <exclude body1="mobile_base_link" body2="caster_swivel_front_right"/>
    <exclude body1="mobile_base_link" body2="caster_swivel_rear_left"/>
    <exclude body1="mobile_base_link" body2="caster_swivel_rear_right"/>
    <exclude body1="mobile_base_link" body2="caster_wheel_front_left"/>
    <exclude body1="mobile_base_link" body2="caster_wheel_front_right"/>
    <exclude body1="mobile_base_link" body2="caster_wheel_rear_left"/>
    <exclude body1="mobile_base_link" body2="caster_wheel_rear_right"/>
  </contact>

  <actuator>
    <velocity name="left_wheel" joint="left_wheel" kv="1000" ctrlrange="-12.566370614359172 12.566370614359172" forcerange="-4 4"/>
    <velocity name="right_wheel" joint="right_wheel" kv="1000" ctrlrange="-12.566370614359172 12.566370614359172" forcerange="-4 4"/>
  </actuator>
</mujoco>
